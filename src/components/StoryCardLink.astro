---
/**
 * The "Photo" control: downloads the activity's 1080x1920 story card
 * (story/integration.mjs). aikyam.space's StoryCardLink.astro, with the
 * download named after the partner rather than aikyam.
 */
import { getT } from '../lib/content';
import { href } from '../lib/links';
import { partner } from '../lib/partner';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const t = await getT();
// The file on disk is story.jpg (a 255-byte slug cannot be a filename); the
// name a reader sees comes from `download`, cut to 60 characters of slug.
const fileName = `${partner.slug}-${slug.slice(0, 60).replace(/-+$/, '')}.jpg`;
---

<a class="sharelink" href={href(`/activities/${slug}/story.jpg`)} download={fileName} aria-label={t('storycard.download_aria')}>
  {/* A framed photograph with a sun and a hill — aikyam.space's picture glyph. */}
  <svg
    class="sharelink__icon"
    viewBox="0 0 24 24"
    width="17"
    height="17"
    aria-hidden="true"
    focusable="false"
    fill="none"
    stroke="currentColor"
    stroke-width="1.9"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect x="3" y="4" width="18" height="16" rx="2" />
    <circle cx="8.5" cy="9.5" r="1.4" />
    <path d="M21 15.5 16 10.5 6.5 20" />
  </svg>
  <span class="sharelink__label">{t('storycard.download')}</span>
</a>
