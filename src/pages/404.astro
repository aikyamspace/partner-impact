---
/** GitHub Pages serves dist/404.html for any path that does not exist. */
import Site from '../layouts/Site.astro';
import { href } from '../lib/links';
---

<Site title="Page not found">
  <div class="wrap wrap--wide">
    <section class="impact-head">
      <h1>Page not found</h1>
      <p>This page does not exist. See <a href={href('/activities/')}>all activities</a> or go to the <a href={href('/')}>impact page</a>.</p>
    </section>
  </div>
</Site>
